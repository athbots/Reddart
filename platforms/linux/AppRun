#!/usr/bin/env bash
# Reddart AppImage Execution Wrapper
# Enables Wayland fractional scaling, sets up LD_LIBRARY_PATH, XDG_DATA_DIRS, and launches binary.

set -e

# Resolve AppDir absolute path
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
export APPDIR="${APPDIR:-$SELF_DIR}"

# Wayland Fractional Scaling Support
# Detect whether running under native Wayland session
if [ -n "${WAYLAND_DISPLAY:-}" ] || [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
    export WINIT_UNIX_BACKEND="${WINIT_UNIX_BACKEND:-wayland}"
    export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
    export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
fi

# Set library search paths
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib64:${APPDIR}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"

# Set XDG data directories for desktop entry, icons, and effect manifests
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Set Reddart Effects search directory if bundled in AppImage
if [ -d "${APPDIR}/usr/share/reddart/effects" ]; then
    export REDDART_EFFECTS_DIR="${APPDIR}/usr/share/reddart/effects"
fi

# Execute native binary
BIN="${APPDIR}/usr/bin/reddart"
if [ ! -f "$BIN" ]; then
    BIN="${APPDIR}/bin/reddart"
fi

if [ -f "$BIN" ]; then
    exec "$BIN" "$@"
else
    echo "Reddart AppImage: binary not found in $APPDIR" >&2
    exit 1
fi
